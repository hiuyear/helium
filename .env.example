# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional, local-only — needed by scripts/embed.js if RLS blocks anon deletes.
# Never set this in the deployed function's env; that stays read-only on anon.
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Calendar booking (optional — booking tools register only when refresh token is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
BOOKING_TIMEZONE=America/Toronto
BOOKING_DURATION_MINUTES=30
BOOKING_HOURS_START=09:00
BOOKING_HOURS_END=19:00
BOOKING_DAYS=1,2,3,4,5

# Outbound messages via Resend (optional — send_message tool registers only when set)
RESEND_API_KEY=
MESSAGE_TO_EMAIL=hiuyan.kwok@mail.utoronto.ca
MESSAGE_FROM_EMAIL=Helium <hello@hiuyankwok.com>
